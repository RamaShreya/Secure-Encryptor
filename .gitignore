# Byte-compiled / optimized Python files
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.pyc

# Virtual environments and local secrets
venv/
.venv/
env/
ENV/
.env
.env.*

# Build, packaging, and installer output
build/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
*.egg
*.spec
MANIFEST

# Test, coverage, and tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Runtime data generated by Secure Encryptor
logs/*
database/*.db
database/*.sqlite
database/*.sqlite3
encrypted_files/*
decrypted_files/*
keys/*
temp/*

# Keep project folders
!logs/.gitkeep
!database/.gitkeep
!encrypted_files/.gitkeep
!decrypted_files/.gitkeep
!keys/.gitkeep
!temp/.gitkeep

# IDE settings
.idea/
.vscode/

# OS and temporary files
Thumbs.db
Desktop.ini
.DS_Store
*.tmp
*.temp
*.log
*.bak
*.swp
